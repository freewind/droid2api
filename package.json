{
  "name": "droid2api",
  "version": "1.3.8",
  "description": "OpenAI Compatible API Proxy",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "service:restart": "launchctl kickstart -k gui/$(id -u)/com.freewind.droid2api",
    "service:uninstall": "launchctl bootout gui/$(id -u)/com.freewind.droid2api"
  },
  "keywords": ["openai", "api", "proxy"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "https-proxy-agent": "^7.0.2",
    "node-fetch": "^3.3.2"
  }
}
